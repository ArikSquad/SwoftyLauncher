{
  "schema_version": 1,
  "targets": [
    { "erp": "2025_asset_groups/ui_package/flow_frontend.erp", "resource": "eaid://ui_package/screens/fe_home.ui" },
    { "erp": "2025_asset_groups/ui_package/screens/fe_home.erp", "resource": "eaid://ui_package/screens/fe_home.ui" }
  ],
  "root": "Screens[0]:fe_home",
  "edits": [
    { "op": "clone-node", "src": "tooltips.settings", "as": "mod_menu", "set": { "tooltipsName": "mod_menu" } },
    { "op": "set-props", "node": "tooltips.mod_menu.text", "set": { "localise": false } },
    {
      "op": "clone-node",
      "src": "settings",
      "as": "mod_menu_listener",
      "set": { "action_name": "Menu Right Stick Click" },
      "replace_event": {
        "event": "pressed",
        "signals": [
          { "to": "fe_home.Action", "pin": "route", "attrs": { "key": "mod_menu" } },
          { "to": "fe_home.audio_theme_trigger", "pin": "confirm" }
        ]
      }
    },
    {
      "op": "set-text",
      "node": "contextual_panels.offline_contextual_panel.subtitle",
      "value": "Launched with Swofty Mod Launcher",
      "localise": false
    },
    {
      "op": "set-text",
      "node": "contextual_panels.offline_contextual_panel.tooltip_label",
      "value": "to open settings",
      "localise": false
    },
    {
      "op": "set-props",
      "node": "contextual_panels.offline_contextual_panel.tooltip_extra_2",
      "set": { "tooltipsName": "mod_menu_offline" }
    },
    {
      "op": "remove-signal",
      "node": "contextual_panels.contextual_decision",
      "event": "offline",
      "to": "fe_home.contextual_panels.extra_2_listener"
    },
    {
      "op": "add-signal",
      "node": "contextual_panels.contextual_decision",
      "event": "default",
      "signal": { "to": "fe_home.contextual_panels.offline_contextual_panel", "pin": "show", "from": "default" }
    }
  ]
}
