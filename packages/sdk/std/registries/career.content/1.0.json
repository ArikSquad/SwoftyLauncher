{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "career.content 1.0",
  "x-registry": "career.content",
  "x-version": "1.0",
  "x-applies": "boot",
  "x-snapshot": false,
  "description": "career::Content: a career tile and the data it clones. A 1.5 swofty::career::content::add call provides one, under the calling addon's id and the content's id.",
  "type": "object",
  "properties": {
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "career.mode"
    },
    "tile": {
      "$ref": "#/$defs/path",
      "description": "the tile image"
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "career.content",
      "description": "the stock content it clones: game/f1_career_2026 or game/f1_career_2025"
    },
    "calendar": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "career.calendar"
    },
    "after_last": {
      "enum": [
        "market",
        "hold",
        "end"
      ],
      "default": "market"
    },
    "title": {
      "$ref": "#/$defs/text",
      "description": "the tile's title"
    },
    "description": {
      "$ref": "#/$defs/text",
      "description": "the tile's description"
    },
    "data_group": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "maxLength": 63,
      "description": "the career tables and save slots of this content"
    },
    "suffix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]*$",
      "maxLength": 15,
      "description": "Choose Driver formats F1CAREER_%s, F2CAREER_%s and ICONS_%s with it"
    },
    "save_container": {
      "type": "string",
      "pattern": "^[a-z0-9_]*$",
      "maxLength": 63,
      "description": "save_data.name of the game_modes.ModeChampionship row (the 1.5 descriptor's mode)"
    },
    "car_group": {
      "type": "integer",
      "minimum": -1,
      "description": "the customisation car group stat_id a press selects; -1: the model's"
    },
    "badge": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "the tile's notification value; 0 shows no badge"
    },
    "entitlement": {
      "type": "string",
      "maxLength": 48,
      "description": "replaces the 2026 model's entitlement string; empty keeps it"
    },
    "careers": {
      "enum": [
        "driver",
        "my_team",
        "both"
      ],
      "default": "driver"
    },
    "extends": {
      "description": "Data files only: this record is a variant of that record, and its value is a merge patch on the base.",
      "type": "string",
      "x-ref": "career.content",
      "x-missing": {
        "default": "required",
        "allow": [
          "required"
        ]
      }
    }
  },
  "required": [
    "data_group"
  ],
  "additionalProperties": true,
  "$defs": {
    "path": {
      "description": "A Path: a file or folder in the addon's folder, the game's original file (stock), or resources in an archive. null: empty.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        {
          "type": "object",
          "properties": {
            "stock": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            }
          },
          "required": [
            "stock"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "prefix": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "textures",
                  "materials",
                  "idf",
                  "wep"
                ]
              }
            }
          },
          "required": [
            "erp",
            "prefix",
            "kinds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^eaid://"
              }
            }
          },
          "required": [
            "erp",
            "resources"
          ],
          "additionalProperties": false
        }
      ]
    },
    "text": {
      "description": "A Text: a lang key as a string, or a literal.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "string"
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
