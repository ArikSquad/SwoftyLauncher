{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "career.character 1.0",
  "x-registry": "career.character",
  "x-version": "1.0",
  "x-applies": "content",
  "x-snapshot": false,
  "description": "career::Character: a career's people. The 1.5 swofty::characters calls provide one per calling addon and data group: its swaps, muted speakers and career strings.",
  "type": "object",
  "properties": {
    "replaces": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "career.character"
    },
    "first_name": {
      "$ref": "#/$defs/text"
    },
    "last_name": {
      "$ref": "#/$defs/text"
    },
    "portrait": {
      "$ref": "#/$defs/path",
      "description": "the core makes the message_avatars slice"
    },
    "mute": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "speakers whose lines play at speech volume 0: agent, agent_cutscene"
    },
    "data_group": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "maxLength": 63
    },
    "swaps": {
      "type": "array",
      "x-key": [
        "character"
      ],
      "items": {
        "$ref": "#/$defs/swap"
      },
      "description": "a character row and the row it shows (portrait, names, job)"
    },
    "strings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "description": "language code or \"*\" -> lng key -> text, while a career of the data group is loaded"
    },
    "extends": {
      "description": "Data files only: this record is a variant of that record, and its value is a merge patch on the base.",
      "type": "string",
      "x-ref": "career.character",
      "x-missing": {
        "default": "required",
        "allow": [
          "required"
        ]
      }
    }
  },
  "required": [
    "data_group"
  ],
  "additionalProperties": true,
  "$defs": {
    "path": {
      "description": "A Path: a file or folder in the addon's folder, the game's original file (stock), or resources in an archive. null: empty.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        {
          "type": "object",
          "properties": {
            "stock": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            }
          },
          "required": [
            "stock"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "prefix": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "textures",
                  "materials",
                  "idf",
                  "wep"
                ]
              }
            }
          },
          "required": [
            "erp",
            "prefix",
            "kinds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^eaid://"
              }
            }
          },
          "required": [
            "erp",
            "resources"
          ],
          "additionalProperties": false
        }
      ]
    },
    "text": {
      "description": "A Text: a lang key as a string, or a literal.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "string"
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "swap": {
      "description": "career::CharacterSwap: the character row named character shows the row named with.",
      "type": "object",
      "properties": {
        "character": {
          "type": "string"
        },
        "with": {
          "type": "string"
        }
      },
      "required": [
        "character",
        "with"
      ],
      "additionalProperties": false
    }
  }
}
