{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "helmet 1.0",
  "x-registry": "helmet",
  "x-version": "1.0",
  "x-applies": "boot",
  "x-snapshot": false,
  "description": "wearables::Helmet: a customisation.custom_avatar.helmets row and its archive.",
  "type": "object",
  "properties": {
    "archive": {
      "$ref": "#/$defs/path"
    },
    "from": {
      "description": "The shell and row it starts from.",
      "type": [
        "string",
        "null"
      ],
      "x-ref": "helmet"
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "driver": {
      "description": "Who can pick it; null: any driver.",
      "type": [
        "string",
        "null"
      ],
      "x-ref": "driver.identity"
    },
    "colours": {
      "$ref": "#/$defs/item_colours"
    },
    "official_team_item": {
      "type": "boolean"
    },
    "stat_id": {
      "$ref": "#/$defs/stat_id"
    },
    "extends": {
      "description": "Data files only: this record is a variant of that record, and its value is a merge patch on the base.",
      "type": "string",
      "x-ref": "helmet",
      "x-missing": {
        "default": "required",
        "allow": [
          "required"
        ]
      }
    }
  },
  "required": [
    "archive"
  ],
  "additionalProperties": true,
  "$defs": {
    "path": {
      "description": "A Path: a file or folder in the addon's folder, the game's original file (stock), or resources in an archive. null: empty.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        {
          "type": "object",
          "properties": {
            "stock": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            }
          },
          "required": [
            "stock"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "prefix": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "textures",
                  "materials",
                  "idf",
                  "wep"
                ]
              }
            }
          },
          "required": [
            "erp",
            "prefix",
            "kinds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^eaid://"
              }
            }
          },
          "required": [
            "erp",
            "resources"
          ],
          "additionalProperties": false
        }
      ]
    },
    "item_colours": {
      "description": "colour_1..4_default; null or absent: the from row's.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/colour"
          }
        }
      ]
    },
    "colour": {
      "description": "A Colour: \"#RRGGBB\" or \"#AARRGGBB\".",
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "stat_id": {
      "description": "A StatId: an explicit id, or \"auto\" (absent: \"auto\") for the core to allocate one.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "auto"
        }
      ]
    },
    "text": {
      "description": "A Text: a lang key as a string, or a literal.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "string"
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
