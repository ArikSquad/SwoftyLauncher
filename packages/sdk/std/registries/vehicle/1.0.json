{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vehicle 1.0",
  "x-registry": "vehicle",
  "x-version": "1.0",
  "x-applies": "boot",
  "x-snapshot": false,
  "description": "cars::Vehicle: one entrants.vehicles row: a car, its package, model, sound, livery, handling, power unit and AI data.",
  "type": "object",
  "properties": {
    "package": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "vehicle.package"
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "donor": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "vehicle"
    },
    "model": {
      "$ref": "#/$defs/path",
      "description": "null or absent: the donor's"
    },
    "engine_sound": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "engine_sound",
      "x-missing": {
        "default": "fallback",
        "to": "/donor"
      }
    },
    "livery": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "livery"
    },
    "handling": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "vehicle.handling"
    },
    "power_unit": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "power_unit"
    },
    "ai": {
      "$ref": "#/$defs/ai_slot"
    },
    "performance_class": {
      "enum": [
        "f1",
        "f1_26",
        "f2",
        "classic",
        "my_team",
        "safety_car"
      ],
      "default": "f1"
    },
    "performance_tier": {
      "type": "integer",
      "minimum": 0
    },
    "tyre_wear_scale": {
      "type": "number",
      "minimum": 0,
      "default": 1.0
    },
    "stat_id": {
      "$ref": "#/$defs/stat_id"
    },
    "extends": {
      "description": "Data files only: this record is a variant of that record, and its value is a merge patch on the base.",
      "type": "string",
      "x-ref": "vehicle",
      "x-missing": {
        "default": "required",
        "allow": [
          "required"
        ]
      }
    }
  },
  "required": [
    "label"
  ],
  "additionalProperties": true,
  "$defs": {
    "path": {
      "description": "A Path: a file or folder in the addon's folder, the game's original file (stock), or resources in an archive. null: empty.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        {
          "type": "object",
          "properties": {
            "stock": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            }
          },
          "required": [
            "stock"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "prefix": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "textures",
                  "materials",
                  "idf",
                  "wep"
                ]
              }
            }
          },
          "required": [
            "erp",
            "prefix",
            "kinds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^eaid://"
              }
            }
          },
          "required": [
            "erp",
            "resources"
          ],
          "additionalProperties": false
        }
      ]
    },
    "stat_id": {
      "description": "A StatId: an explicit id, or \"auto\" (absent: \"auto\") for the core to allocate one.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "auto"
        }
      ]
    },
    "ai_slot": {
      "description": "cars::AiSlot: where the car's AI data comes from.",
      "type": "object",
      "properties": {
        "track_pack": {
          "type": [
            "string",
            "null"
          ],
          "x-ref": "ai.track_pack"
        },
        "asset_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$",
          "default": "auto"
        }
      },
      "additionalProperties": false
    }
  }
}
