{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vehicle.handling 1.0",
  "x-registry": "vehicle.handling",
  "x-version": "1.0",
  "x-applies": "session",
  "x-snapshot": false,
  "description": "cars::Handling: one car handling file: the sections and keys it holds, in snake_case. A section is an open object. The 1.6.0 core stores handling records and applies nothing from them.",
  "type": "object",
  "properties": {
    "from": {
      "type": [
        "string",
        "null"
      ],
      "x-ref": "vehicle.handling"
    },
    "vtf": {
      "$ref": "#/$defs/path"
    },
    "class": {
      "enum": [
        "f1",
        "f1_26",
        "f2",
        "classic",
        "my_team",
        "safety_car"
      ],
      "default": "f1"
    },
    "damage_scale": {
      "type": "number",
      "default": 1.0
    },
    "chassis": {
      "type": "object"
    },
    "f1_aero": {
      "type": "object"
    },
    "core_aero": {
      "type": "object"
    },
    "wing_damage": {
      "type": "object"
    },
    "suspension_damage": {
      "type": "object"
    },
    "tyre_damage": {
      "type": "object"
    },
    "body_damage": {
      "type": "object"
    },
    "tyres": {
      "type": "object"
    },
    "engine": {
      "type": "object"
    },
    "gearbox": {
      "type": "object"
    },
    "fuel_tank": {
      "type": "object"
    },
    "fuel_ecu": {
      "type": "object"
    },
    "brake_ecu": {
      "type": "object"
    },
    "steering": {
      "type": "object"
    },
    "differential": {
      "type": "object"
    },
    "suspension": {
      "type": "object"
    },
    "tuning": {
      "type": "object"
    },
    "assists": {
      "type": "object"
    },
    "turbo": {
      "type": "object"
    },
    "ers": {
      "type": "object"
    },
    "plank": {
      "type": "object"
    },
    "rad_upgrades": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rad_upgrade"
      }
    },
    "extends": {
      "description": "Data files only: this record is a variant of that record, and its value is a merge patch on the base.",
      "type": "string",
      "x-ref": "vehicle.handling",
      "x-missing": {
        "default": "required",
        "allow": [
          "required"
        ]
      }
    }
  },
  "required": [],
  "additionalProperties": true,
  "$defs": {
    "path": {
      "description": "A Path: a file or folder in the addon's folder, the game's original file (stock), or resources in an archive. null: empty.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        {
          "type": "object",
          "properties": {
            "stock": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            }
          },
          "required": [
            "stock"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "prefix": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "textures",
                  "materials",
                  "idf",
                  "wep"
                ]
              }
            }
          },
          "required": [
            "erp",
            "prefix",
            "kinds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^eaid://"
              }
            }
          },
          "required": [
            "erp",
            "resources"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rad_upgrade": {
      "description": "cars::RadUpgrade: a named set of edits to the handling file's keys.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "section": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "=",
                  "+",
                  "-",
                  "*"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "section",
              "key",
              "op",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "changes"
      ],
      "additionalProperties": false
    }
  }
}
