          "game/williams": {
            "status": "ok",
            "value": {
              "images": {
                "driver_select": "logos/williams_2017_driver_select.png",
                "team_select": "logos/williams_2017_team_select.png",
                "hud": "logos/progressive_williams_hud.png",
                "broadcast": "badges/williams_broadcast.png",
                "hub": {
                  "stock": "ui/team_logos/williams_hub.png"
                }
              }
            },
            "origins": {
