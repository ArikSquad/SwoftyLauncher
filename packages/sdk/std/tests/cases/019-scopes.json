          "patch": {
            "n": 1
          }
        },
        {
          "op": "layer",
          "registry": "test.thing",
          "target": "game/a",
          "patch": {
            "n": 2
          },
          "scope": "profile",
          "profile": "p1"
        },
        {
          "op": "layer",
          "registry": "test.thing",
          "target": "game/a",
          "patch": {
            "name": "c"
          },
          "scope": "career",
          "career": "c1"
