{
  "name": "profile layers apply in their profile, career layers in their career",
  "rule": "a global layer applies in every profile; a profile layer only while its profile is active; a career layer only while its career is loaded; within the addon global < profile < career (scopes.md)",
  "registries": {
    "test.thing": {
      "applies": "read",
      "key_fields": {
        "/items": [
          "key"
        ]
      }
    }
  },
  "bases": [
    {
      "addon": "game",
      "registry": "test.thing",
      "key": "a",
      "value": {
        "name": "a",
        "n": 0,
        "kind": "f1",
        "items": []
      }
    }
  ],
  "tags": {},
