{
  "name": "an option-bound layer follows the option's value",
  "rule": "\"when\" binds a layer to one of its addon's options (is: one value, in: several, on/off: a toggle); each evaluation is the result after the option changed, with the bound edits run again (layers.md#option-bound-layers)",
  "registries": {
    "vehicle.handling": {
      "applies": "session"
    }
  },
  "bases": [
    {
      "addon": "game",
      "registry": "vehicle.handling",
      "key": "ferrari_2025",
      "value": {
        "class": "f1",
        "damage_scale": 1.0
      }
    },
    {
      "addon": "game",
      "registry": "vehicle.handling",
      "key": "f2_2025",
      "value": {
        "class": "f2",
        "damage_scale": 1.0
      }
    }
  ],
  "tags": {},
  "addons": [
    {
      "id": "william09leo.heavier-damage-realism",
      "ops": [
        {
          "op": "layer",
          "registry": "vehicle.handling",
          "select": {
            "where": {
              "class": "f1"
            }
          },
          "when": {
            "option": "damage",
            "is": "heavy"
          },
          "patch": {
            "damage_scale": 1.6
          }
        },
        {
          "op": "layer",
          "registry": "vehicle.handling",
          "select": {
            "where": {
              "class": "f1"
            }
          },
          "when": {
            "option": "damage",
            "is": "brutal"
          },
          "patch": {
            "damage_scale": 2.4
          }
        },
        {
          "op": "layer",
          "registry": "vehicle.handling",
          "select": {
            "where": {
              "class": "f2"
            }
          },
          "when": {
            "option": "damage",
            "in": [
              "heavy",
              "brutal"
            ]
          },
          "patch": {
            "damage_scale": 1.3
          }
        }
      ]
    },
    {
      "id": "kizi.wet",
      "ops": [
        {
          "op": "layer",
          "registry": "vehicle.handling",
          "select": {
            "where": {
              "class": "f2"
            }
          },
          "when": {
            "option": "wet",
            "on": true
          },
          "edit": [
            {
              "op": "mul",
              "path": "/damage_scale",
              "value": 2
            }
          ]
        },
        {
          "op": "layer",
          "registry": "vehicle.handling",
          "select": {
            "where": {
              "class": "f1"
            }
          },
          "when": {
            "option": "wet",
            "off": true
          },
          "patch": {
            "class": "f1"
          }
        }
      ]
    }
  ],
  "evaluations": [
    {
