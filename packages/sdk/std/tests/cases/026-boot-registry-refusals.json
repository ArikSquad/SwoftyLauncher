{
  "name": "a boot registry refuses .in() filters and late writes",
  "rule": "on an Applies::boot registry a layer with \"in\" is refused (boot_filtered), and add, variant and layer outside SWOFTY_REGISTER (\"stage\": \"on_load\") are refused as late; the same late layer on a read registry applies (layers.md#where-a-layer-applies, providers.md#threads-and-timing)",
  "registries": {
    "vehicle": {
      "applies": "boot"
    },
    "test.thing": {
      "applies": "read"
    }
  },
  "bases": [
    {
      "addon": "game",
      "registry": "vehicle",
      "key": "ferrari_2025",
      "value": {
        "label": "ferrari_2025",
        "performance_tier": 0,
        "tyre_wear_scale": 1.0
      }
    },
    {
      "addon": "game",
      "registry": "vehicle",
      "key": "redbull_2025",
      "value": {
        "label": "redbull_2025",
        "performance_tier": 0,
        "tyre_wear_scale": 1.0
      }
    },
    {
      "addon": "game",
      "registry": "test.thing",
      "key": "a",
      "value": {
        "name": "a",
        "n": 0,
        "kind": "f1",
        "items": []
      }
    }
  ],
  "tags": {},
