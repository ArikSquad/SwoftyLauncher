          "target": "game/a",
          "patch": {
            "name": "dg"
          },
          "in": [
            {
              "data_group": "f1_career_progressive"
            }
          ]
        }
      ]
    },
    {
      "id": "mod.d",
      "ops": [
        {
          "op": "layer",
          "registry": "test.thing",
          "target": "game/b",
          "patch": {
            "n": 7
