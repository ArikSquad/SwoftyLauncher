{
  "name": "a layer with .in() applies only where its selectors match",
  "rule": "\"in\" lists selectors that must all match the context (mode, content with its variant chain, content_exact, data_group, setup_mode, any); on a read or content registry get includes the layer only while they match (layers.md#where-a-layer-applies, events.md#scope)",
  "registries": {
    "test.thing": {
      "applies": "read",
      "key_fields": {
        "/items": [
          "key"
        ]
      }
    }
  },
  "bases": [
    {
      "addon": "game",
      "registry": "test.thing",
      "key": "a",
      "value": {
        "name": "a",
        "n": 0,
        "kind": "f1",
        "items": []
      }
    },
    {
      "addon": "game",
      "registry": "test.thing",
      "key": "b",
      "value": {
        "name": "b",
        "n": 0,
        "kind": "f1",
        "items": []
      }
    },
    {
      "addon": "game",
      "registry": "test.thing",
      "key": "c",
      "value": {
        "name": "c",
        "n": 0,
        "kind": "f1",
        "items": []
      }
    }
  ],
  "tags": {},
  "addons": [
    {
      "id": "mod.a",
      "ops": [
        {
          "op": "layer",
          "registry": "test.thing",
          "target": "game/a",
          "patch": {
            "n": 1
          },
          "in": [
            {
              "mode": "driver_career"
            }
          ]
        }
      ]
    },
    {
      "id": "mod.b",
      "ops": [
        {
          "op": "layer",
          "registry": "test.thing",
          "select": {
            "ids": "*"
          },
          "patch": {
            "kind": "x"
          },
          "in": [
            {
              "content": "swofty.classic-seasons-2017/f1_2017"
            }
