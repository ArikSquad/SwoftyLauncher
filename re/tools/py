#!/usr/bin/env bash
P=/nix/store/b9jqx1ly7sjsdw12pknds5jqc70i40c1-python3-3.14.6-env/bin/python3
if [ ! -x "$P" ]; then
    P=$(nix build --no-link --print-out-paths --impure --expr 'with import <nixpkgs> {}; python3.withPackages (p: [p.numpy p.pefile p.capstone])')/bin/python3 || exit 1
fi
exec taskset -c 2-7,10,11,14-31 nice -n 10 "$P" "$@"
