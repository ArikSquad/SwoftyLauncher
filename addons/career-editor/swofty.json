    "game_builds": [
      ">=25251167"
    ],
    "launcher": ">=1.5.6"
  },
  "requires": [
    {
      "id": "swofty.core",
      "version": ">=0.2.11"
    }
  ],
  "launcher": {
    "program": {
      "linux": "bin/career-editor-helper",
      "windows": "bin/career-editor-helper.exe"
    },
    "sections": [
      {
        "id": "editor",
        "title": "Career Editor",
        "icon": "gauge"
      }
    ]
  },
  "operations": {
    "native": [
      {
        "dll": "native/career_editor.dll"
      }
    ]
  }
}
