{
  "schema_version": 1,
  "id": "swofty.custom-grid-size",
  "name": "Custom Grid Size",
  "version": "0.1.0",
  "author": "Swofty",
  "description": "Choose how many cars race in F1 2026 Grand Prix sessions.",
  "license": "AGPL-3.0-or-later",
  "kind": ["database", "erp"],
  "compat": { "game": "f1_25", "game_builds": [">=25251167"], "seasons": ["f1_2026"] },
  "requires": [{ "id": "swofty.core", "version": ">=0.1.0" }],
  "options": [
    {
      "id": "cars",
      "type": "slider",
      "label": "Cars",
      "description": "Cars in an F1 2026 Grand Prix. Each step above 22 adds a team of two, and every 2026 track gets the grid slots, garages and pit boxes to match where they fit.",
      "min": 22,
      "max": 30,
      "step": 2,
      "default": 26,
      "binds": "db"
    }
  ],
  "operations": {
    "database": ["db/grid.json"],
    "erp": [
      "tracks/abu_dhabi.json",
      "tracks/austria.json",
      "tracks/austria_reverse.json",
      "tracks/bahrain.json",
      "tracks/baku.json",
      "tracks/brazil.json",
      "tracks/catalunya.json",
      "tracks/hungaroring.json",
      "tracks/imola.json",
      "tracks/jeddah.json",
      "tracks/las_vegas.json",
      "tracks/losail.json",
      "tracks/madrid.json",
      "tracks/melbourne.json",
      "tracks/mexico.json",
      "tracks/miami.json",
      "tracks/monaco.json",
      "tracks/montreal.json",
      "tracks/monza.json",
      "tracks/shanghai.json",
      "tracks/silverstone.json",
      "tracks/silverstone_reverse.json",
      "tracks/singapore.json",
      "tracks/spa_francorchamps.json",
      "tracks/suzuka.json",
      "tracks/texas.json",
      "tracks/zandvoort.json",
      "tracks/zandvoort_reverse.json"
    ]
  }
}
