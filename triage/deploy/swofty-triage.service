[Unit]
Description=Swofty Launcher log triage bot
After=network-online.target
Wants=network-online.target

[Service]
User=triage
Group=triage
EnvironmentFile=/etc/swofty-triage.env
Environment=TRIAGE_DATA_DIR=/var/lib/swofty-triage
ExecStart=/opt/swofty-triage/venv/bin/swofty-triage run
Restart=always
RestartSec=15
StateDirectory=swofty-triage
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=768M

[Install]
WantedBy=multi-user.target
